<!--
  Windows Discovery Detection Rules
  Wazuh + Sysmon Detection Engineering Lab

  Detects common Windows discovery utilities using
  Sysmon Event ID 1 (Process Creation).
-->

<group name="windows_discovery,">

  <!-- T1033 - System Owner/User Discovery -->
  <rule id="100100" level="6">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\whoami\.exe$</field>
    <description>Windows user discovery command executed: whoami.exe</description>
    <mitre>
      <id>T1033</id>
    </mitre>
    <group>discovery_command,</group>
  </rule>

  <!-- T1016 - System Network Configuration Discovery -->
  <rule id="100101" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\ipconfig\.exe$</field>
    <description>Windows network configuration discovery detected: ipconfig.exe</description>
    <mitre>
      <id>T1016</id>
    </mitre>
    <group>discovery_command,</group>
  </rule>

  <!-- T1082 - System Information Discovery -->
  <rule id="100102" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\systeminfo\.exe$</field>
    <description>Windows system information discovery detected: systeminfo.exe</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>discovery_command,</group>
  </rule>

  <!-- T1082 - System Information Discovery -->
  <rule id="100103" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\hostname\.exe$</field>
    <description>Windows system name discovery detected: hostname.exe</description>
    <mitre>
      <id>T1082</id>
    </mitre>
    <group>discovery_command,</group>
  </rule>

  <!-- T1057 - Process Discovery -->
  <rule id="100104" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\tasklist\.exe$</field>
    <description>Windows process discovery detected: tasklist.exe</description>
    <mitre>
      <id>T1057</id>
    </mitre>
    <group>discovery_command,</group>
  </rule>

  <!-- T1049 - System Network Connections Discovery -->
  <rule id="100105" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)\\netstat\.exe$</field>
    <description>Windows network connection discovery detected: netstat.exe</description>
    <mitre>
      <id>T1049</id>
    </mitre>
    <group>discovery_command,</group>
  </rule>

  <!-- Behavioral correlation -->
  <rule id="100106" level="8" frequency="3" timeframe="120">
    <if_matched_group>discovery_command</if_matched_group>
    <description>Multiple Windows discovery commands detected within 120 seconds</description>
    <group>discovery_correlation,</group>
  </rule>

</group>
